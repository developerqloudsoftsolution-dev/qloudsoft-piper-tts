# Voice model: hi_IN-priyamvada-medium, hi_IN-rohan-medium, en_GB-jenny_dioco-medium, en_US-amy-low
PIPER_MODEL=hi_IN-priyamvada-medium

# Max character length for input text
MAX_TEXT_LENGTH=500

# Optional API key for Bearer authentication
API_KEY=your_secret_api_key_here

# Server binding
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
